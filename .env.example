# Local development only. Keep actual values in an untracked .env file.
# Public browser identifiers
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only production secrets — never prefix these with VITE_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Optional Noor connector server settings
NOOR_CONNECTOR_ENABLED=false
NOOR_CLIENT_ID=
NOOR_CLIENT_SECRET=
NOOR_REDIRECT_URI=
NOOR_ALLOW_READ=false
NOOR_ALLOW_WRITE=false
