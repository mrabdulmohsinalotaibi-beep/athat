-- جعل الـ bucket عامًا للقراءة
update storage.buckets set public = true where id = 'program-evidence';

-- سياسات القراءة والكتابة
create policy "public read" on storage.objects
for select using (bucket_id = 'program-evidence');

create policy "auth insert" on storage.objects
for insert to authenticated with check (bucket_id = 'program-evidence');

create policy "auth delete" on storage.objects
for delete to authenticated using (bucket_id = 'program-evidence');