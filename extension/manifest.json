{
  "manifest_version": 3,
  "name": "Athat Bridge — نور ومدرستي",
  "version": "0.3.0",
  "description": "جسر الذات داخل نور ومدرستي: معاينة ومطابقة ثم تعبئة الأعمال المصرح بها في جلسة المستخدم.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://noor.moe.gov.sa/*",
    "https://schools.madrasati.sa/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_title": "Athat Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://noor.moe.gov.sa/*",
        "https://schools.madrasati.sa/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}