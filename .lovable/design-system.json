import React, { useState, useMemo, useEffect, useRef } from 'react';
import {
  Search,
  Plus,
  Printer,
  Trash2,
  Edit2,
  X,
  CheckCircle,
  AlertCircle,
  Phone,
  UserCheck,
  FileText,
  Upload,
  Download,
  Bot,
  Sparkles,
  Loader2
} from 'lucide-react';
import * as XLSX from 'xlsx';

// --- الأنواع والتصاميم (Types & Interfaces) ---
export interface Student {
  id: string;
  name: string;
  nationalId: string;
  grade: string;
  classRoom: string;
  phone: string;
  status: 'منتظم' | 'موقوف' | 'منتقل';
  casesCount: number;
  aiRecommendation?: string;
}

export interface Toast {
  id: string;
  type: 'success' | 'error' | 'info';
  message: string;
}

// --- البيانات الأولية الافتراضية ---
const INITIAL_STUDENTS: Student[] = [
  { id: '1', name: 'عبدالله محمد الشهري', nationalId: '1092837465', grade: 'الأول المتوسط', classRoom: '1/1', phone: '0501234567', status: 'منتظم', casesCount: 2, aiRecommendation: 'توصية DeepSeek: يفضل عقد جلسة إرشاد فردية لبحث أسباب الغياب المتكرر وتنظيم خطة متابعة سلوكية.' },
  { id: '2', name: 'خالد أحمد الغامدي', nationalId: '1083746521', grade: 'الثاني المتوسط', classRoom: '2/1', phone: '0552345678', status: 'منتظم', casesCount: 0, aiRecommendation: 'توصية DeepSeek: الطالب منتظم ولا يوجد لديه أي ملاحظات، يُوصى بتشجيعه وتعزيز التفوق.' },
  { id: '3', name: 'فهد سار العتيبي', nationalId: '1074658392', grade: 'الثالث المتوسط', classRoom: '3/2', phone: '0543456789', status: 'منتظم', casesCount: 5, aiRecommendation: 'توصية DeepSeek: يُوصى باستدعاء ولي الأمر وتفعيل خطة التدخل المباشر لتقليل السلوكيات المخالفة.' },
];

// --- أدوات المساعدة والتحقق (Helpers & Validation) ---
const normalizeArabic = (text: string): string => {
  return text
    .replace(/[أإآ]/g, 'ا')
    .replace(/ة/g, 'ه')
    .replace(/ى/g, 'ي')
    .replace(/[\u064B-\u0652]/g, '')
    .trim()
    .toLowerCase();
};

const sanitizeText = (text: string): string => {
  return text.replace(/[<>&'"]/g, '').trim();
};

const isValidSaudiId = (id: string): boolean => {
  return /^[12]\d{9}$/.test(id);
};

const isValidSaudiPhone = (phone: string): boolean => {
  return /^(05|9665|\+9665)\d{8}$/.test(phone);
};

const generateId = (): string => Math.random().toString(36).substring(2, 9);

// --- محاكاة خدمة DeepSeek AI لإنشاء توصيات تربوية سريعة ---
const generateDeepSeekAnalysis = async (student: Partial<Student>): Promise<string> => {
  // محاكاة تأخير الاستجابة من النموذج
  await new Promise((resolve) => setTimeout(resolve, 1000));

  const cases = student.casesCount || 0;
  if (cases === 0) {
    return `تحليل DeepSeek: السجل السلوكي للطالب (${student.name || 'الجديد'}) ممتاز. يوصى بتعزيز التكيف الايجابي وإشراكه في الأنشطة الطلابية.`;
  } else if (cases <= 2) {
    return `تحليل DeepSeek: توجد (${cases}) حالات مسجلة. يُوصى بتقديم جلسة توجيه فردية ومتابعة تحصيله الدراسي مع معلم الصف.`;
  } else {
    return `تحليل DeepSeek: رصد (${cases}) حالات سلوكية. يتطلب خطة تعديل سلوك مكثفة بالتعاون مع ولي الأمر والتوجيه الطلابي.`;
  }
};

// --- المكون الرئيسي (Main Component) ---
export default function StudentManagementSystem() {
  const [students, setStudents] = useState<Student[]>(() => {
    const saved = localStorage.getItem('guidance_students');
    return saved ? JSON.parse(saved) : INITIAL_STUDENTS;
  });

  const [searchTerm, setSearchTerm] = useState('');
  const [selectedGrade, setSelectedGrade] = useState('الكل');
  const [isAddModalOpen, setIsAddModalOpen] = useState(false);
  const [editingStudent, setEditingStudent] = useState<Student | null>(null);
  const [printableStudent, setPrintableStudent] = useState<Student | null>(null);
  const [toasts, setToasts] = useState<Toast[]>([]);
  const [isAnalyzing, setIsAnalyzing] = useState<string | null>(null);

  // Form State
  const [formData, setFormData] = useState({
    name: '',
    nationalId: '',
    grade: 'الأول المتوسط',
    classRoom: '1/1',
    phone: '',
    status: 'منتظم' as Student['status'],
    casesCount: 0,
    aiRecommendation: '',
  });

  const fileInputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    localStorage.setItem('guidance_students', JSON.stringify(students));
  }, [students]);

  useEffect(() => {
    if (isAddModalOpen || editingStudent || printableStudent) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = 'unset';
    }
  }, [isAddModalOpen, editingStudent, printableStudent]);

  const pushToast = (type: Toast['type'], message: string) => {
    const id = generateId();
    setToasts((prev) => [...prev, { id, type, message }]);
    setTimeout(() => {
      setToasts((prev) => prev.filter((t) => t.id !== id));
    }, 4000);
  };

  const filteredStudents = useMemo(() => {
    const normalizedSearch = normalizeArabic(searchTerm);
    return students.filter((student) => {
      const matchesSearch =
        normalizeArabic(student.name).includes(normalizedSearch) ||
        student.nationalId.includes(normalizedSearch) ||
        student.phone.includes(normalizedSearch);
      const matchesGrade = selectedGrade === 'الكل' || student.grade === selectedGrade;
      return matchesSearch && matchesGrade;
    });
  }, [students, searchTerm, selectedGrade]);

  const handleOpenAddModal = () => {
    setFormData({
      name: '',
      nationalId: '',
      grade: 'الأول المتوسط',
      classRoom: '1/1',
      phone: '',
      status: 'منتظم',
      casesCount: 0,
      aiRecommendation: '',
    });
    setIsAddModalOpen(true);
  };

  const handleOpenEditModal = (student: Student) => {
    setEditingStudent(student);
    setFormData({
      name: student.name,
      nationalId: student.nationalId,
      grade: student.grade,
      classRoom: student.classRoom,
      phone: student.phone,
      status: student.status,
      casesCount: student.casesCount,
      aiRecommendation: student.aiRecommendation || '',
    });
  };

  const handleSaveStudent = async (e: React.FormEvent) => {
    e.preventDefault();

    const cleanName = sanitizeText(formData.name);
    const cleanId = formData.nationalId.trim();
    const cleanPhone = formData.phone.trim();

    if (!cleanName) {
      pushToast('error', 'يرجى إدخال اسم الطالب ثلاثي على الأقل.');
      return;
    }

    if (!isValidSaudiId(cleanId)) {
      pushToast('error', 'رقم الهوية غير صحيح (يجب أن يتكون من 10 أرقام ويبدأ بـ 1 أو 2).');
      return;
    }

    if (cleanPhone && !isValidSaudiPhone(cleanPhone)) {
      pushToast('error', 'رقم الجوال غير صحيح (مثال: 0501234567).');
      return;
    }

    // توليد توصية DeepSeek التلقائية في حال عدم وجود توصية مخصصة
    let finalAiRec = formData.aiRecommendation;
    if (!finalAiRec) {
      finalAiRec = await generateDeepSeekAnalysis({ name: cleanName, casesCount: formData.casesCount });
    }

    if (editingStudent) {
      setStudents((prev) =>
        prev.map((s) =>
          s.id === editingStudent.id
            ? { ...s, ...formData, name: cleanName, nationalId: cleanId, phone: cleanPhone, aiRecommendation: finalAiRec }
            : s
        )
      );
      pushToast('success', 'تم تعديل بيانات الطالب وتحديث تحليل DeepSeek.');
      setEditingStudent(null);
    } else {
      const newStudent: Student = {
        id: generateId(),
        name: cleanName,
        nationalId: cleanId,
        grade: formData.grade,
        classRoom: formData.classRoom,
        phone: cleanPhone || 'غير مسجل',
        status: formData.status,
        casesCount: formData.casesCount,
        aiRecommendation: finalAiRec,
      };
      setStudents((prev) => [newStudent, ...prev]);
      pushToast('success', 'تمت إضافة الطالب وتحليل السجل عبر DeepSeek AI.');
      setIsAddModalOpen(false);
    }
  };

  const handleDeleteStudent = (id: string) => {
    if (confirm('هل أنت تأكد من رغبتك في حذف هذا الطالب؟')) {
      setStudents((prev) => prev.filter((s) => s.id !== id));
      pushToast('info', 'تم حذف الطالب من السجل.');
    }
  };

  // إرسال الطالب للتحليل بواسطة DeepSeek AI
  const handleRunDeepSeek = async (studentId: string) => {
    setIsAnalyzing(studentId);
    const student = students.find((s) => s.id === studentId);
    if (!student) return;

    const newAiRecommendation = await generateDeepSeekAnalysis(student);

    setStudents((prev) =>
      prev.map((s) => (s.id === studentId ? { ...s, aiRecommendation: newAiRecommendation } : s))
    );

    setIsAnalyzing(null);
    pushToast('success', `تم توليد تحليل DeepSeek للطالب ${student.name}`);
  };

  // Excel Import
  const handleExcelImport = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = async (evt) => {
      try {
        const bstr = evt.target?.result;
        const wb = XLSX.read(bstr, { type: 'binary' });
        const wsname = wb.SheetNames[0];
        const ws = wb.Sheets[wsname];
        const data = XLSX.utils.sheet_to_json<any>(ws);

        const imported: Student[] = await Promise.all(
          data.map(async (row) => {
            const name = sanitizeText(row['اسم الطالب'] || row['الاسم'] || row['Name'] || 'طالب جديد');
            const nationalId = String(row['السجل المدني'] || row['الهوية'] || row['رقم الهوية'] || row['National ID'] || '').trim();
            const casesCount = Number(row['الحالات السلوكية'] || row['عدد الحالات'] || 0);

            const aiRec = await generateDeepSeekAnalysis({ name, casesCount });

            return {
              id: generateId(),
              name,
              nationalId,
              grade: row['الصف'] || row['Grade'] || 'الأول المتوسط',
              classRoom: row['الفصل'] || row['Class'] || '1/1',
              phone: String(row['الجوال'] || row['رقم التواصل'] || row['Phone'] || '').trim(),
              status: 'منتظم',
              casesCount,
              aiRecommendation: aiRec,
            };
          })
        );

        const validImported = imported.filter((s) => isValidSaudiId(s.nationalId));

        if (validImported.length === 0) {
          pushToast('error', 'لم يتم العثور على سجلات صالحة. يرجى التأكد من وجود عمود (السجل المدني) أو (الهوية).');
          return;
        }

        setStudents((prev) => [...validImported, ...prev]);
        pushToast('success', `تم استيراد ${validImported.length} طالب بنجاح وتحليل بياناتهم عبر DeepSeek.`);
      } catch (err) {
        pushToast('error', 'حدث خطأ أثناء قراءة ملف الإكسل.');
      }
    };
    reader.readAsBinaryString(file);
    if (e.target) e.target.value = '';
  };

  // Excel Export
  const handleExportExcel = () => {
    const exportData = filteredStudents.map((s) => ({
      'اسم الطالب': s.name,
      'رقم الهوية/السجل': s.nationalId,
      'الصف الدراسي': s.grade,
      'الفصل': s.classRoom,
      'رقم التواصل': s.phone,
      'الحالة السلوكية': s.status,
      'عدد الحالات': s.casesCount,
      'توصيات الذكاء الاصطناعي (DeepSeek)': s.aiRecommendation || 'لا يوجد',
    }));

    const ws = XLSX.utils.json_to_sheet(exportData);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'الطلاب');
    XLSX.writeFile(wb, `سجل_الطلاب_${new Date().toISOString().slice(0, 10)}.xlsx`);
    pushToast('info', 'تم تصدير ملف الإكسل بنجاح.');
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 dir-rtl font-sans p-4 md:p-8" dir="rtl">
      {/* Toast Notifications */}
      <div className="fixed bottom-5 left-5 z-50 space-y-2 max-w-sm w-full pointer-events-none">
        {toasts.map((toast) => (
          <div
            key={toast.id}
            className={`pointer-events-auto p-4 rounded-xl shadow-lg border flex items-center gap-3 transition-all ${
              toast.type === 'success'
                ? 'bg-emerald-50 border-emerald-200 text-emerald-800'
                : toast.type === 'error'
                ? 'bg-rose-50 border-rose-200 text-rose-800'
                : 'bg-sky-50 border-sky-200 text-sky-800'
            }`}
          >
            {toast.type === 'success' && <CheckCircle className="w-5 h-5 text-emerald-600 shrink-0" />}
            {toast.type === 'error' && <AlertCircle className="w-5 h-5 text-rose-600 shrink-0" />}
            {toast.type === 'info' && <FileText className="w-5 h-5 text-sky-600 shrink-0" />}
            <span className="text-sm font-medium">{toast.message}</span>
          </div>
        ))}
      </div>

      <div className="max-w-7xl mx-auto space-y-6">
        {/* Header Section */}
        <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div>
            <h1 className="text-2xl font-bold text-slate-900 flex items-center gap-2">
              <UserCheck className="w-7 h-7 text-indigo-600" />
              نظام إدارة وجاهزية الطلاب (المُدعّم بـ DeepSeek AI)
            </h1>
            <p className="text-slate-500 text-sm mt-1">
              متابعة الطلاب، استيراد وتصدير الإكسل، وتوليد التوصيات التربوية المباشرة.
            </p>
          </div>

          <div className="flex flex-wrap items-center gap-2 w-full md:w-auto">
            <input
              type="file"
              ref={fileInputRef}
              onChange={handleExcelImport}
              accept=".xlsx, .xls, .csv"
              className="hidden"
            />
            <button
              onClick={() => fileInputRef.current?.click()}
              className="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 px-4 py-2.5 rounded-xl font-medium text-sm transition-colors"
            >
              <Upload className="w-4 h-4" />
              استيراد إكسل (Excel)
            </button>

            <button
              onClick={handleExportExcel}
              className="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-slate-100 text-slate-700 hover:bg-slate-200 px-4 py-2.5 rounded-xl font-medium text-sm transition-colors"
            >
              <Download className="w-4 h-4" />
              تصدير إكسل
            </button>

            <button
              onClick={handleOpenAddModal}
              className="flex-1 md:flex-none inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-medium text-sm shadow-sm transition-colors"
            >
              <Plus className="w-4 h-4" />
              إضافة طالب جديد
            </button>
          </div>
        </div>

        {/* Filters & Search */}
        <div className="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-col md:flex-row gap-4 justify-between items-center">
          <div className="relative w-full md:w-96">
            <Search className="w-5 h-5 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2" />
            <input
              type="text"
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              placeholder="ابحث بالاسم، السجل المدني، أو الجوال..."
              className="w-full pl-4 pr-10 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm"
            />
          </div>

          <div className="flex items-center gap-2 w-full md:w-auto overflow-x-auto pb-2 md:pb-0">
            {['الكل', 'الأول المتوسط', 'الثاني المتوسط', 'الثالث المتوسط'].map((grade) => (
              <button
                key={grade}
                onClick={() => setSelectedGrade(grade)}
                className={`px-4 py-2 rounded-xl text-sm font-medium whitespace-nowrap transition-colors ${
                  selectedGrade === grade
                    ? 'bg-indigo-50 text-indigo-700 border border-indigo-200'
                    : 'bg-slate-50 text-slate-600 hover:bg-slate-100'
                }`}
              >
                {grade}
              </button>
            ))}
          </div>
        </div>

        {/* Table View */}
        <div className="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <div className="overflow-x-auto">
            <table className="w-full text-right border-collapse">
              <thead>
                <tr className="bg-slate-50 border-b border-slate-200 text-slate-600 text-xs font-semibold uppercase tracking-wider">
                  <th className="py-4 px-6">الطالب</th>
                  <th className="py-4 px-6">السجل المدني</th>
                  <th className="py-4 px-6">الصف والفصل</th>
                  <th className="py-4 px-6">التواصل</th>
                  <th className="py-4 px-6">تحليل وتوصيات DeepSeek AI</th>
                  <th className="py-4 px-6 text-center">الإجراءات</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100 text-sm">
                {filteredStudents.length > 0 ? (
                  filteredStudents.map((student) => (
                    <tr key={student.id} className="hover:bg-slate-50/80 transition-colors">
                      <td className="py-4 px-6 font-medium text-slate-900">
                        <div className="flex items-center gap-3">
                          <div className="w-9 h-9 rounded-full bg-indigo-50 text-indigo-700 font-bold flex items-center justify-center shrink-0">
                            {student.name.charAt(0)}
                          </div>
                          <div>
                            <p className="font-semibold text-slate-900">{student.name}</p>
                            <span className="inline-block px-2 py-0.5 text-xs rounded-md bg-slate-100 text-slate-600 mt-0.5">
                              {student.status}
                            </span>
                          </div>
                        </div>
                      </td>
                      <td className="py-4 px-6 font-mono text-slate-600">{student.nationalId}</td>
                      <td className="py-4 px-6 text-slate-600">
                        {student.grade} - <span className="font-semibold">{student.classRoom}</span>
                      </td>
                      <td className="py-4 px-6 text-slate-600">
                        <div className="flex items-center gap-1.5 font-mono dir-ltr justify-end">
                          <Phone className="w-3.5 h-3.5 text-slate-400" />
                          <span>{student.phone}</span>
                        </div>
                      </td>
                      <td className="py-4 px-6 max-w-xs">
                        <div className="bg-indigo-50/50 p-2.5 rounded-xl border border-indigo-100 text-xs text-indigo-900 space-y-1">
                          <div className="flex items-center justify-between">
                            <span className="font-bold flex items-center gap-1 text-indigo-700">
                              <Sparkles className="w-3.5 h-3.5 text-indigo-600" /> DeepSeek
                            </span>
                            <button
                              onClick={() => handleRunDeepSeek(student.id)}
                              disabled={isAnalyzing === student.id}
                              className="text-[10px] bg-indigo-600 hover:bg-indigo-700 text-white px-2 py-0.5 rounded-md flex items-center gap-1"
                            >
                              {isAnalyzing === student.id ? (
                                <Loader2 className="w-3 h-3 animate-spin" />
                              ) : (
                                'تحديث'
                              )}
                            </button>
                          </div>
                          <p className="line-clamp-2 leading-relaxed text-slate-700">
                            {student.aiRecommendation || 'اضغط تحديث لتوليد التحليل عبر DeepSeek.'}
                          </p>
                        </div>
                      </td>
                      <td className="py-4 px-6">
                        <div className="flex items-center justify-center gap-2">
                          <button
                            onClick={() => setPrintableStudent(student)}
                            title="طباعة التقرير الشامل"
                            className="p-2 text-slate-500 hover:text-indigo-600 hover:bg-slate-100 rounded-lg transition-colors"
                          >
                            <Printer className="w-4 h-4" />
                          </button>
                          <button
                            onClick={() => handleOpenEditModal(student)}
                            title="تعديل البيانات"
                            className="p-2 text-slate-500 hover:text-amber-600 hover:bg-slate-100 rounded-lg transition-colors"
                          >
                            <Edit2 className="w-4 h-4" />
                          </button>
                          <button
                            onClick={() => handleDeleteStudent(student.id)}
                            title="حذف الطالب"
                            className="p-2 text-slate-500 hover:text-rose-600 hover:bg-slate-100 rounded-lg transition-colors"
                          >
                            <Trash2 className="w-4 h-4" />
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colSpan={6} className="text-center py-12 text-slate-400">
                      لا توجد نتائج مطابقة للبحث.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

        {/* Modal: Add/Edit Student */}
        {(isAddModalOpen || editingStudent) && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 overflow-y-auto">
            <div className="bg-white rounded-2xl shadow-xl border border-slate-100 w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-200">
              <div className="p-5 border-b border-slate-100 flex justify-between items-center">
                <h3 className="font-bold text-lg text-slate-900">
                  {editingStudent ? 'تعديل بيانات الطالب' : 'إضافة طالب جديد'}
                </h3>
                <button
                  onClick={() => {
                    setIsAddModalOpen(false);
                    setEditingStudent(null);
                  }}
                  className="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>

              <form onSubmit={handleSaveStudent} className="p-6 space-y-4">
                <div>
                  <label className="block text-xs font-semibold text-slate-700 mb-1">اسم الطالب كاملاً</label>
                  <input
                    type="text"
                    required
                    autoFocus
                    value={formData.name}
                    onChange={(e) => setFormData({ ...formData, name: e.target.value })}
                    placeholder="مثال: محمد بن سلمان العتيبي"
                    className="w-full p-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
                  />
                </div>

                <div>
                  <label className="block text-xs font-semibold text-slate-700 mb-1">السجل المدني / الهوية</label>
                  <input
                    type="text"
                    required
                    maxLength={10}
                    value={formData.nationalId}
                    onChange={(e) => setFormData({ ...formData, nationalId: e.target.value })}
                    placeholder="10XXXXXXXX"
                    className="w-full p-2.5 rounded-xl border border-slate-200 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
                  />
                </div>

                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <label className="block text-xs font-semibold text-slate-700 mb-1">الصف الدراسي</label>
                    <select
                      value={formData.grade}
                      onChange={(e) => setFormData({ ...formData, grade: e.target.value })}
                      className="w-full p-2.5 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
                    >
                      <option value="الأول المتوسط">الأول المتوسط</option>
                      <option value="الثاني المتوسط">الثاني المتوسط</option>
                      <option value="الثالث المتوسط">الثالث المتوسط</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-xs font-semibold text-slate-700 mb-1">الفصل</label>
                    <input
                      type="text"
                      required
                      value={formData.classRoom}
                      onChange={(e) => setFormData({ ...formData, classRoom: e.target.value })}
                      placeholder="1/1"
                      className="w-full p-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
                    />
                  </div>
                </div>

                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <label className="block text-xs font-semibold text-slate-700 mb-1">رقم الجوال</label>
                    <input
                      type="text"
                      value={formData.phone}
                      onChange={(e) => setFormData({ ...formData, phone: e.target.value })}
                      placeholder="05XXXXXXXX"
                      className="w-full p-2.5 rounded-xl border border-slate-200 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-semibold text-slate-700 mb-1">عدد الحالات السلوكية</label>
                    <input
                      type="number"
                      min={0}
                      value={formData.casesCount}
                      onChange={(e) => setFormData({ ...formData, casesCount: Number(e.target.value) })}
                      className="w-full p-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-xs font-semibold text-slate-700 mb-1">توصيات DeepSeek AI (اختياري)</label>
                  <textarea
                    rows={3}
                    value={formData.aiRecommendation}
                    onChange={(e) => setFormData({ ...formData, aiRecommendation: e.target.value })}
                    placeholder="يمكنك كتابة التوصية يدوياً أو ترك الخانة فارغة ليقوم DeepSeek بتوليدها تلقائياً..."
                    className="w-full p-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
                  />
                </div>

                <div className="pt-4 flex items-center justify-end gap-3 border-t border-slate-100">
                  <button
                    type="button"
                    onClick={() => {
                      setIsAddModalOpen(false);
                      setEditingStudent(null);
                    }}
                    className="px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 text-sm font-medium"
                  >
                    إلغاء
                  </button>
                  <button
                    type="submit"
                    className="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium shadow-sm flex items-center gap-2"
                  >
                    <Sparkles className="w-4 h-4" />
                    حفظ وتحليل DeepSeek
                  </button>
                </div>
              </form>
            </div>
          </div>
        )}

        {/* Modal / Print Preview Report */}
        {printableStudent && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 overflow-y-auto print:p-0 print:bg-white print:fixed print:inset-0">
            <div className="bg-white rounded-2xl shadow-xl border border-slate-100 w-full max-w-3xl overflow-hidden print:shadow-none print:border-none print:w-full">
              {/* Header Buttons - Hidden on Print */}
              <div className="p-4 bg-slate-50 border-b border-slate-100 flex justify-between items-center print:hidden">
                <span className="text-sm font-semibold text-slate-700">معاينة التقرير الشامل للطباعة</span>
                <div className="flex items-center gap-2">
                  <button
                    onClick={() => window.print()}
                    className="inline-flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-xl text-sm font-medium hover:bg-indigo-700 transition-colors"
                  >
                    <Printer className="w-4 h-4" />
                    طباعة التقرير
                  </button>
                  <button
                    onClick={() => setPrintableStudent(null)}
                    className="p-2 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-200"
                  >
                    <X className="w-5 h-5" />
                  </button>
                </div>
              </div>

              {/* Printable Content Area */}
              <div className="p-8 space-y-6 print:p-8 font-sans text-right dir-rtl">
                {/* Kingdom Header */}
                <div className="flex justify-between items-center border-b pb-6 border-slate-200">
                  <div className="text-xs text-slate-600 space-y-1">
                    <p className="font-bold">المملكة العربية السعودية</p>
                    <p>وزارة التعليم</p>
                    <p>إدارة التعليم</p>
                  </div>
                  <div className="text-center">
                    <h2 className="text-lg font-bold text-slate-900">تقرير حالة طالب وتوجيه تربوي</h2>
                    <p className="text-xs text-slate-500 mt-1">مدعوم بتحليل الذكاء الاصطناعي (DeepSeek AI)</p>
                  </div>
                  <div className="w-20 h-20 bg-slate-100 rounded-xl flex items-center justify-center text-xs text-slate-400 border border-slate-200">
                    شعار المدرسة
                  </div>
                </div>

                {/* Student Personal Information */}
                <div className="grid grid-cols-2 gap-4 text-sm bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <div>
                    <span className="text-slate-500 text-xs block">اسم الطالب الثلاثي:</span>
                    <span className="font-bold text-slate-800">{printableStudent.name}</span>
                  </div>
                  <div>
                    <span className="text-slate-500 text-xs block">السجل المدني / الهوية:</span>
                    <span className="font-mono font-bold text-slate-800">{printableStudent.nationalId}</span>
                  </div>
                  <div>
                    <span className="text-slate-500 text-xs block">الصف والفصل:</span>
                    <span className="font-bold text-slate-800">{printableStudent.grade} - {printableStudent.classRoom}</span>
                  </div>
                  <div>
                    <span className="text-slate-500 text-xs block">رقم التواصل:</span>
                    <span className="font-mono font-bold text-slate-800 dir-ltr text-right">{printableStudent.phone}</span>
                  </div>
                </div>

                {/* DeepSeek AI Analysis Section */}
                <div className="space-y-2 text-sm bg-indigo-50/60 p-4 rounded-xl border border-indigo-100">
                  <p className="font-bold text-indigo-900 flex items-center gap-1.5">
                    <Bot className="w-4 h-4 text-indigo-600" />
                    تحليل وتوصية DeepSeek AI المدمجة:
                  </p>
                  <p className="text-xs text-slate-700 leading-relaxed font-sans">
                    {printableStudent.aiRecommendation || 'لم يتم توليد تحليل لهذا الطالب بعد.'}
                  </p>
                </div>

                {/* Recommendations and Actions */}
                <div className="space-y-3 text-sm">
                  <p className="font-bold text-slate-900">التوصيات والإجراءات التوجيهية:</p>
                  <div className="p-4 border rounded-xl bg-slate-50/50 min-h-[100px] text-slate-700 leading-relaxed text-xs">
                    بناءً على التقرير السلوكي وتوصيات الذكاء الاصطناعي، تم اعتماد الخطة التوجيهية المرفقة ومتابعة حالة الطالب بانتظام.
                  </div>
                </div>

                {/* Signatures */}
                <div className="grid grid-cols-2 gap-8 pt-10 text-center text-xs font-bold text-slate-800">
                  <div>
                    <p>الموجه الطلابي</p>
                    <p className="mt-12 text-slate-400 font-normal">( التوقيع: ............................ )</p>
                  </div>
                  <div>
                    <p>مدير المدرسة</p>
                    <p className="mt-12 text-slate-400 font-normal">( التوقيع والختم الرسمي )</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}