import React, { useState, useEffect, useMemo, useCallback } from 'react';
import {
  UserPlus, FileSpreadsheet, Printer, MessageSquare,
  Sparkles, Search, Download, Upload, ShieldCheck, X, AlertCircle, CheckCircle2
} from 'lucide-react';

// ====================================================================
// 1. الأنواع (Types)
// ====================================================================
type StudentStatus = 'منتظم' | 'متابعة سلوكية' | 'غياب متكرر' | 'متفوق';

interface Student {
  id: string;
  name: string;
  nationalId: string;
  grade: string;
  classRoom: string;
  phone: string;
  status: StudentStatus;
  casesCount: number;
}

type NewStudentForm = Omit<Student, 'id' | 'casesCount'>;

interface ToastMessage {
  id: string;
  type: 'success' | 'error' | 'info';
  text: string;
}

// ====================================================================
// 2. أدوات مساعدة (Helpers)
// ====================================================================
const generateId = (): string => {
  if (typeof crypto !== 'undefined' && 'randomUUID' in crypto) {
    return crypto.randomUUID();
  }
  return `${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
};

const sanitizeText = (input: string): string =>
  input.replace(/[<>"'`]/g, '').trim();

const normalizeArabic = (text: string): string =>
  text
    .toLowerCase()
    .replace(/[أإآ]/g, 'ا')
    .replace(/ى/g, 'ي')
    .replace(/ة/g, 'ه')
    .replace(/[\u064B-\u065F]/g, '')
    .trim();

const isValidSaudiId = (id: string): boolean => /^\d{10}$/.test(id);

const isValidSaudiPhone = (phone: string): boolean =>
  /^9665\d{8}$/.test(phone);

const buildWhatsAppMessage = (student: Student): string => {
  const safeName = sanitizeText(student.name);
  const safeStatus = sanitizeText(student.status);
  return `السلام عليكم ورحمة الله وبركاته، المكرم ولي أمر الطالب (${safeName}).
نود إحاطتكم بخطاب متابعة من مكتب التوجيه الطلابي بخصوص الحالة: (${safeStatus}).
يرجى التواصل معنا في أقرب وقت.`;
};

// ====================================================================
// 3. البيانات الأولية (Mock Data)
// ====================================================================
const INITIAL_STUDENTS: Student[] = [
  { id: generateId(), name: 'أحمد محمد العتيبي', nationalId: '1102938475', grade: 'الأول المتوسط', classRoom: '1/1', phone: '966501234567', status: 'منتظم', casesCount: 0 },
  { id: generateId(), name: 'خالد عبدالله الشهري', nationalId: '1192837465', grade: 'الثاني المتوسط', classRoom: '2/1', phone: '966507654321', status: 'متابعة سلوكية', casesCount: 2 },
  { id: generateId(), name: 'فيصل القحطاني', nationalId: '1092837411', grade: 'الثالث المتوسط', classRoom: '3/2', phone: '966509988776', status: 'غياب متكرر', casesCount: 4 },
];

const EMPTY_FORM: NewStudentForm = {
  name: '',
  nationalId: '',
  grade: 'الأول المتوسط',
  classRoom: '1/1',
  phone: '',
  status: 'منتظم',
};

// ====================================================================
// 4. مكون Toast بسيط
// ====================================================================
const ToastContainer: React.FC<{ toasts: ToastMessage[]; onClose: (id: string) => void }> = ({ toasts, onClose }) => (
  <div className="fixed top-4 left-4 z-[100] space-y-2 max-w-sm">
    {toasts.map((t) => (
      <div
        key={t.id}
        role="alert"
        className={`flex items-start gap-2 p-3 rounded-xl shadow-lg border text-xs font-semibold animate-in fade-in slide-in-from-top-2 ${
          t.type === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-800' :
          t.type === 'error'   ? 'bg-rose-50 border-rose-200 text-rose-800' :
                                 'bg-slate-50 border-slate-200 text-slate-800'
        }`}
      >
        {t.type === 'success' ? <CheckCircle2 className="w-4 h-4 mt-0.5 shrink-0" /> : <AlertCircle className="w-4 h-4 mt-0.5 shrink-0" />}
        <span className="flex-1 leading-relaxed">{t.text}</span>
        <button onClick={() => onClose(t.id)} aria-label="إغلاق التنبيه">
          <X className="w-3.5 h-3.5 opacity-60 hover:opacity-100" />
        </button>
      </div>
    ))}
  </div>
);

// ====================================================================
// 5. المكون الرئيسي
// ====================================================================
export default function GuidanceHubComplete() {
  // -----------------------------
  // الحالات (State)
  // -----------------------------
  const [students, setStudents] = useState<Student[]>(INITIAL_STUDENTS);
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedStudent, setSelectedStudent] = useState<Student | null>(null);

  // النوافذ
  const [isAddModalOpen, setIsAddModalOpen] = useState(false);
  const [isNoorModalOpen, setIsNoorModalOpen] = useState(false);
  const [isPrintModalOpen, setIsPrintModalOpen] = useState(false);
  const [isAiModalOpen, setIsAiModalOpen] = useState(false);

  // المساعد الذكي
  const [aiPrompt, setAiPrompt] = useState('');
  const [aiResponse, setAiResponse] = useState('');
  const [isAiLoading, setIsAiLoading] = useState(false);

  // نموذج الإضافة
  const [newStudent, setNewStudent] = useState<NewStudentForm>(EMPTY_FORM);
  const [formError, setFormError] = useState('');

  // التنبيهات
  const [toasts, setToasts] = useState<ToastMessage[]>([]);

  // -----------------------------
  // أدوات مساعدة داخلية
  // -----------------------------
  const pushToast = useCallback((type: ToastMessage['type'], text: string) => {
    const id = generateId();
    setToasts((prev) => [...prev, { id, type, text }]);
    setTimeout(() => {
      setToasts((prev) => prev.filter((t) => t.id !== id));
    }, 4000);
  }, []);

  const closeToast = useCallback((id: string) => {
    setToasts((prev) => prev.filter((t) => t.id !== id));
  }, []);

  // -----------------------------
  // إغلاق المودالات بزر Escape + منع التمرير
  // -----------------------------
  const anyModalOpen =
    isAddModalOpen || isNoorModalOpen || isPrintModalOpen || isAiModalOpen;

  useEffect(() => {
    if (!anyModalOpen) return;

    const onKey = (e: KeyboardEvent) => {
      if (e.key !== 'Escape') return;
      setIsAddModalOpen(false);
      setIsNoorModalOpen(false);
      setIsPrintModalOpen(false);
      setIsAiModalOpen(false);
    };

    document.addEventListener('keydown', onKey);
    const prevOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';

    return () => {
      document.removeEventListener('keydown', onKey);
      document.body.style.overflow = prevOverflow;
    };
  }, [anyModalOpen]);

  // -----------------------------
  // الفلترة (memo + normalize)
  // -----------------------------
  const filteredStudents = useMemo(() => {
    const q = normalizeArabic(searchQuery);
    if (!q) return students;
    return students.filter((s) => {
      return (
        normalizeArabic(s.name).includes(q) ||
        s.nationalId.includes(searchQuery.trim()) ||
        normalizeArabic(s.grade).includes(q)
      );
    });
  }, [students, searchQuery]);

  // -----------------------------
  // إضافة طالب جديد
  // -----------------------------
  const handleAddStudent = (e: React.FormEvent) => {
    e.preventDefault();
    setFormError('');

    const trimmedName = sanitizeText(newStudent.name);
    const trimmedId = newStudent.nationalId.trim();
    const trimmedPhone = newStudent.phone.trim();
    const trimmedClass = sanitizeText(newStudent.classRoom);

    if (!trimmedName || trimmedName.length < 3) {
      setFormError('اسم الطالب يجب أن يكون 3 أحرف على الأقل.');
      return;
    }
    if (!isValidSaudiId(trimmedId)) {
      setFormError('السجل المدني يجب أن يكون 10 أرقام.');
      return;
    }
    if (students.some((s) => s.nationalId === trimmedId)) {
      setFormError('هذا السجل المدني مسجل مسبقاً في المنصة.');
      return;
    }
    if (trimmedPhone && !isValidSaudiPhone(trimmedPhone)) {
      setFormError('رقم الجوال يجب أن يبدأ بـ 9665 ويتكون من 12 رقماً.');
      return;
    }

    const student: Student = {
      id: generateId(),
      name: trimmedName,
      nationalId: trimmedId,
      grade: newStudent.grade,
      classRoom: trimmedClass || '1/1',
      phone: trimmedPhone,
      status: newStudent.status,
      casesCount: 0,
    };

    setStudents((prev) => [student, ...prev]);
    setNewStudent(EMPTY_FORM);
    setIsAddModalOpen(false);
    pushToast('success', `تم إضافة الطالب "${student.name}" بنجاح.`);
  };

  // -----------------------------
  // استيراد من نور (محاكاة)
  // -----------------------------
  const handleNoorImport = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    // (ملاحظة: لقراءة ملفات Excel/CSV الحقيقية استخدم مكتبة مثل xlsx أو papaparse)
    setTimeout(() => {
      const imported: Student[] = [
        { id: generateId(), name: 'سلمان الدوسري (استيراد نور)', nationalId: '1188223344', grade: 'الأول المتوسط', classRoom: '1/2', phone: '966551122334', status: 'منتظم', casesCount: 0 },
        { id: generateId(), name: 'عمر المطيري (استيراد نور)',   nationalId: '1177334455', grade: 'الثاني المتوسط', classRoom: '2/2', phone: '966554433221', status: 'متفوق', casesCount: 0 },
      ];

      // تجنب تكرار السجل المدني
      const existingIds = new Set(students.map((s) => s.nationalId));
      const newOnes = imported.filter((s) => !existingIds.has(s.nationalId));

      if (newOnes.length === 0) {
        pushToast('info', 'لم يتم استيراد أي طالب جديد (جميعهم مسجلون مسبقاً).');
      } else {
        setStudents((prev) => [...newOnes, ...prev]);
        pushToast('success', `تم استيراد ${newOnes.length} طالب من نظام نور.`);
      }

      setIsNoorModalOpen(false);
      e.target.value = '';
    }, 800);
  };

  // -----------------------------
  // إرسال واتساب
  // -----------------------------
  const sendWhatsApp = (student: Student) => {
    if (!student.phone || !isValidSaudiPhone(student.phone)) {
      pushToast('error', 'رقم جوال ولي الأمر غير صالح أو غير مسجل.');
      return;
    }
    const url = `https://wa.me/${student.phone}?text=${encodeURIComponent(buildWhatsAppMessage(student))}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  };

  // -----------------------------
  // المساعد الذكي (AI)
  // -----------------------------
  useEffect(() => {
    if (!isAiLoading) return;
    const timer = setTimeout(() => {
      setAiResponse(
        `**الخطة التربوية المقترحة بناءً على تحليل الذكاء الاصطناعي:**\n\n` +
        `1. **التشخيص:** السلوك الناتج يعود لفرط النشاط وتشتت الانتباه أثناء الحصص الأولى.\n` +
        `2. **التوصيات:**\n` +
        `   - إشراك الطالب في الأنشطة الصفية القيادية.\n` +
        `   - عقد جلسة توجيه فردي أسبوعية لمتابعة الأهداف السلوكية.\n` +
        `   - تفعيل المتابعة اليومية مع ولي الأمر عبر بطاقة المتابعة الميدانية.`
      );
      setIsAiLoading(false);
    }, 1500);

    return () => clearTimeout(timer);
  }, [isAiLoading]);

  const generateAiRecommendation = () => {
    if (!aiPrompt.trim()) return;
    setAiResponse('');
    setIsAiLoading(true);
  };

  // -----------------------------
  // طباعة
  // -----------------------------
  const handlePrint = () => {
    window.print();
  };

  const today = new Date().toLocaleDateString('ar-SA');

  // ==================================================================
  // الواجهة (UI)
  // ==================================================================
  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans p-4 sm:p-6 lg:p-8" dir="rtl">
      {/* أنماط الطباعة */}
      <style>{`
        @media print {
          body * { visibility: hidden !important; }
          #printable-area, #printable-area * { visibility: visible !important; }
          #printable-area {
            position: absolute !important;
            inset: 0 !important;
            width: 100% !important;
            padding: 24px !important;
            background: #fff !important;
          }
          .print\\:hidden { display: none !important; }
        }
      `}</style>

      <ToastContainer toasts={toasts} onClose={closeToast} />

      <div className="max-w-7xl mx-auto space-y-6">

        {/* ===== الترويسة ===== */}
        <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div className="flex items-center gap-3">
            <span className="bg-teal-600 text-white p-2 rounded-xl">
              <ShieldCheck className="w-6 h-6" />
            </span>
            <div>
              <h1 className="text-2xl font-bold text-slate-900">منصة الذات - Guidance Hub</h1>
              <p className="text-xs text-slate-500 mt-0.5">النظام الشامل للموجه الطلابي والمعالجة التربوية الذكية</p>
            </div>
          </div>

          <div className="flex flex-wrap items-center gap-2 w-full md:w-auto">
            <button
              onClick={() => { setFormError(''); setNewStudent(EMPTY_FORM); setIsAddModalOpen(true); }}
              className="flex items-center gap-2 bg-teal-700 hover:bg-teal-800 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm"
            >
              <UserPlus className="w-4 h-4" />
              إضافة طالب
            </button>

            <button
              onClick={() => setIsNoorModalOpen(true)}
              className="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm"
            >
              <FileSpreadsheet className="w-4 h-4" />
              استيراد من نور
            </button>

            <button
              onClick={() => setIsAiModalOpen(true)}
              className="flex items-center gap-2 bg-purple-600 hover:bg-purple-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm"
            >
              <Sparkles className="w-4 h-4" />
              المساعد الذكي
            </button>
          </div>
        </div>

        {/* ===== الجدول ===== */}
        <div className="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div className="p-5 border-b border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div className="relative w-full sm:w-96">
              <Search className="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2" />
              <input
                type="text"
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                placeholder="ابحث باسم الطالب، السجل المدني، أو الصف..."
                className="w-full pl-4 pr-9 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-600 transition-all"
              />
            </div>
            <div className="text-xs font-semibold text-slate-500">
              إجمالي الطلاب: <span className="text-slate-900 font-bold">{students.length}</span>
              {searchQuery && (
                <span className="mr-2 text-slate-400">| النتائج: {filteredStudents.length}</span>
              )}
            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full text-right text-xs">
              <thead className="bg-slate-50 text-slate-500 border-b border-slate-200 font-semibold">
                <tr>
                  <th className="p-4">اسم الطالب</th>
                  <th className="p-4">الهوية / السجل</th>
                  <th className="p-4">الصف والفصل</th>
                  <th className="p-4">حالة الطالب</th>
                  <th className="p-4 text-center">الحالات المسجلة</th>
                  <th className="p-4 text-center">الإجراءات</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100">
                {filteredStudents.length === 0 ? (
                  <tr>
                    <td colSpan={6} className="p-8 text-center text-slate-400 text-xs">
                      لا توجد نتائج مطابقة.
                    </td>
                  </tr>
                ) : (
                  filteredStudents.map((student) => (
                    <tr key={student.id} className="hover:bg-slate-50/80 transition-colors">
                      <td className="p-4 font-bold text-slate-900">{student.name}</td>
                      <td className="p-4 font-mono text-slate-600">{student.nationalId}</td>
                      <td className="p-4 text-slate-600">{student.grade} - ({student.classRoom})</td>
                      <td className="p-4">
                        <span className={`inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold ${
                          student.status === 'منتظم' ? 'bg-emerald-50 text-emerald-700' :
                          student.status === 'غياب متكرر' ? 'bg-rose-50 text-rose-700' :
                          student.status === 'متفوق' ? 'bg-sky-50 text-sky-700' :
                          'bg-amber-50 text-amber-700'
                        }`}>
                          {student.status}
                        </span>
                      </td>
                      <td className="p-4 text-center font-bold text-slate-700">{student.casesCount}</td>
                      <td className="p-4">
                        <div className="flex items-center justify-center gap-2">
                          <button
                            onClick={() => sendWhatsApp(student)}
                            aria-label={`إرسال إشعار واتساب لولي أمر ${student.name}`}
                            title="إرسال إشعار عبر WhatsApp"
                            className="p-2 text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors"
                          >
                            <MessageSquare className="w-4 h-4" />
                          </button>

                          <button
                            onClick={() => { setSelectedStudent(student); setIsPrintModalOpen(true); }}
                            aria-label={`طباعة تقرير الطالب ${student.name}`}
                            title="طباعة التقرير الرسمي"
                            className="p-2 text-slate-600 hover:bg-slate-100 rounded-lg transition-colors"
                          >
                            <Printer className="w-4 h-4" />
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

        {/* ===== MODAL 1: إضافة طالب ===== */}
        {isAddModalOpen && (
          <div
            className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4"
            role="dialog"
            aria-modal="true"
            aria-labelledby="add-modal-title"
          >
            <div className="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
              <div className="flex items-center justify-between border-b pb-3">
                <h3 id="add-modal-title" className="font-bold text-slate-900 text-sm">إضافة طالب جديد للمنصة</h3>
                <button onClick={() => setIsAddModalOpen(false)} aria-label="إغلاق">
                  <X className="w-4 h-4 text-slate-400" />
                </button>
              </div>

              <form onSubmit={handleAddStudent} className="space-y-3 text-xs">
                {formError && (
                  <div className="flex items-start gap-2 p-2.5 bg-rose-50 border border-rose-200 rounded-lg text-rose-700 text-[11px]">
                    <AlertCircle className="w-4 h-4 mt-0.5 shrink-0" />
                    <span>{formError}</span>
                  </div>
                )}

                <div>
                  <label className="block text-slate-600 mb-1">اسم الطالب رباعياً</label>
                  <input
                    required
                    type="text"
                    value={newStudent.name}
                    onChange={(e) => setNewStudent({ ...newStudent, name: e.target.value })}
                    className="w-full p-2.5 border rounded-lg bg-slate-50"
                  />
                </div>

                <div>
                  <label className="block text-slate-600 mb-1">رقم الهوية / السجل المدني (10 أرقام)</label>
                  <input
                    required
                    type="text"
                    inputMode="numeric"
                    maxLength={10}
                    value={newStudent.nationalId}
                    onChange={(e) => setNewStudent({ ...newStudent, nationalId: e.target.value.replace(/\D/g, '') })}
                    className="w-full p-2.5 border rounded-lg bg-slate-50 font-mono"
                  />
                </div>

                <div className="grid grid-cols-2 gap-2">
                  <div>
                    <label className="block text-slate-600 mb-1">الصف الدراسي</label>
                    <select
                      value={newStudent.grade}
                      onChange={(e) => setNewStudent({ ...newStudent, grade: e.target.value })}
                      className="w-full p-2.5 border rounded-lg bg-slate-50"
                    >
                      <option>الأول المتوسط</option>
                      <option>الثاني المتوسط</option>
                      <option>الثالث المتوسط</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-slate-600 mb-1">الفصل</label>
                    <input
                      type="text"
                      value={newStudent.classRoom}
                      onChange={(e) => setNewStudent({ ...newStudent, classRoom: e.target.value })}
                      className="w-full p-2.5 border rounded-lg bg-slate-50"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-slate-600 mb-1">جوال ولي الأمر (9665xxxxxxxx)</label>
                  <input
                    type="text"
                    inputMode="numeric"
                    maxLength={12}
                    placeholder="966500000000"
                    value={newStudent.phone}
                    onChange={(e) => setNewStudent({ ...newStudent, phone: e.target.value.replace(/\D/g, '') })}
                    className="w-full p-2.5 border rounded-lg bg-slate-50 font-mono"
                  />
                </div>

                <div>
                  <label className="block text-slate-600 mb-1">الحالة</label>
                  <select
                    value={newStudent.status}
                    onChange={(e) => setNewStudent({ ...newStudent, status: e.target.value as StudentStatus })}
                    className="w-full p-2.5 border rounded-lg bg-slate-50"
                  >
                    <option value="منتظم">منتظم</option>
                    <option value="متفوق">متفوق</option>
                    <option value="متابعة سلوكية">متابعة سلوكية</option>
                    <option value="غياب متكرر">غياب متكرر</option>
                  </select>
                </div>

                <div className="flex justify-end gap-2 pt-3 border-t">
                  <button
                    type="button"
                    onClick={() => setIsAddModalOpen(false)}
                    className="px-4 py-2 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200"
                  >
                    إلغاء
                  </button>
                  <button type="submit" className="px-4 py-2 rounded-lg bg-teal-700 text-white font-semibold hover:bg-teal-800">
                    حفظ الطالب
                  </button>
                </div>
              </form>
            </div>
          </div>
        )}

        {/* ===== MODAL 2: استيراد من نور ===== */}
        {isNoorModalOpen && (
          <div
            className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4"
            role="dialog"
            aria-modal="true"
            aria-labelledby="noor-modal-title"
          >
            <div className="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
              <div className="flex items-center justify-between border-b pb-3">
                <h3 id="noor-modal-title" className="font-bold text-slate-900 text-sm">استيراد القوائم من نظام نور</h3>
                <button onClick={() => setIsNoorModalOpen(false)} aria-label="إغلاق">
                  <X className="w-4 h-4 text-slate-400" />
                </button>
              </div>

              <div className="border-2 border-dashed border-teal-200 bg-teal-50/50 rounded-xl p-6 text-center space-y-3">
                <Upload className="w-8 h-8 text-teal-600 mx-auto" />
                <div className="text-xs text-slate-600">
                  <p className="font-bold">اختر ملف Excel أو CSV المصدّر من نظام نور</p>
                  <p className="text-[10px] text-slate-400 mt-1">
                    يحتوي على أسماء الطلاب والسجل المدني وأرقام التواصل
                  </p>
                </div>
                <input
                  type="file"
                  accept=".xlsx,.xls,.csv"
                  onChange={handleNoorImport}
                  className="hidden"
                  id="noor-file-input"
                />
                <label
                  htmlFor="noor-file-input"
                  className="inline-block bg-teal-700 hover:bg-teal-800 text-white text-xs px-4 py-2 rounded-lg cursor-pointer font-semibold"
                >
                  تصفح الملفات
                </label>
              </div>

              <p className="text-[10px] text-slate-400 text-center leading-relaxed">
                ملاحظة: في هذه النسخة التجريبية، الاستيراد يحاكي البيانات.
                لقراءة ملفات حقيقية استخدم مكتبة <span className="font-mono">papaparse</span> أو <span className="font-mono">xlsx</span>.
              </p>
            </div>
          </div>
        )}

        {/* ===== MODAL 3: المساعد الذكي ===== */}
        {isAiModalOpen && (
          <div
            className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4"
            role="dialog"
            aria-modal="true"
            aria-labelledby="ai-modal-title"
          >
            <div className="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl space-y-4">
              <div className="flex items-center justify-between border-b pb-3">
                <div id="ai-modal-title" className="flex items-center gap-2 text-purple-700 font-bold text-sm">
                  <Sparkles className="w-4 h-4" />
                  المساعد الذكي لصياغة التوصيات
                </div>
                <button onClick={() => setIsAiModalOpen(false)} aria-label="إغلاق">
                  <X className="w-4 h-4 text-slate-400" />
                </button>
              </div>

              <div className="space-y-3 text-xs">
                <textarea
                  rows={3}
                  value={aiPrompt}
                  onChange={(e) => setAiPrompt(e.target.value)}
                  placeholder="اكتب وصفاً مختصراً لحالة الطالب (مثال: طالب يشتكي من تشتت انتباه وتراجع بالدرجات...)..."
                  className="w-full p-3 border rounded-xl bg-slate-50 focus:outline-none focus:ring-2 focus:ring-purple-500/20"
                />

                <button
                  onClick={generateAiRecommendation}
                  disabled={isAiLoading || !aiPrompt.trim()}
                  className="w-full bg-purple-600 hover:bg-purple-700 text-white py-2 rounded-xl font-semibold flex items-center justify-center gap-2 disabled:opacity-50 transition-all"
                >
                  {isAiLoading ? 'جاري التحليل والصياغة...' : 'توليد الحلول التربوية'}
                </button>

                {aiResponse && (
                  <div className="p-4 bg-purple-50/60 border border-purple-100 rounded-xl text-slate-700 text-xs whitespace-pre-line leading-relaxed">
                    {aiResponse}
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {/* ===== MODAL 4: طباعة التقرير ===== */}
        {isPrintModalOpen && selectedStudent && (
          <div
            className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4"
            role="dialog"
            aria-modal="true"
            aria-labelledby="print-modal-title"
          >
            <div className="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">
              <div className="flex items-center justify-between border-b pb-3 print:hidden">
                <h3 id="print-modal-title" className="font-bold text-slate-900 text-sm">
                  معاينة التقرير الرسمي للطباعة
                </h3>
                <div className="flex items-center gap-2">
                  <button
                    onClick={handlePrint}
                    className="bg-teal-700 hover:bg-teal-800 text-white px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5"
                  >
                    <Printer className="w-3.5 h-3.5" /> طباعة
                  </button>
                  <button onClick={() => setIsPrintModalOpen(false)} aria-label="إغلاق">
                    <X className="w-4 h-4 text-slate-400" />
                  </button>
                </div>
              </div>

              <div id="printable-area" className="border p-8 rounded-xl space-y-6 bg-white text-right text-xs">
                {/* الهيدر الرسمي */}
                <div className="flex justify-between items-center border-b-2 border-slate-900 pb-4">
                  <div className="space-y-0.5">
                    <p className="font-bold text-slate-900">المملكة العربية السعودية</p>
                    <p className="text-slate-700">وزارة التعليم</p>
                    <p className="text-slate-600">الإدارة العامة للتعليم بالمحافظة</p>
                    <p className="text-slate-600">مكتب التوجيه الطلابي</p>
                  </div>

                  <div className="text-center">
                    <div className="h-12 w-12 mx-auto rounded-full bg-teal-50 border border-teal-200 flex items-center justify-center">
                      <ShieldCheck className="w-6 h-6 text-teal-700" />
                    </div>
                    <span className="font-bold text-[10px] text-slate-800 block mt-1">
                      منصة الذات للخدمات التربوية
                    </span>
                  </div>

                  <div className="space-y-0.5 text-left">
                    <p><strong>التاريخ:</strong> {today}</p>
                    <p><strong>الرقم المرجعي:</strong> SR-{selectedStudent.id.slice(0, 8)}</p>
                    <p><strong>المرفقات:</strong> يوجد</p>
                  </div>
                </div>

                {/* التفاصيل */}
                <div className="space-y-4">
                  <h2 className="text-center text-sm font-bold underline underline-offset-4 text-slate-900">
                    سجل حالة طالب توجيهي فردي
                  </h2>

                  <div className="grid grid-cols-2 gap-4 bg-slate-50 p-3 rounded-lg border border-slate-200">
                    <p><strong>اسم الطالب:</strong> {selectedStudent.name}</p>
                    <p><strong>السجل المدني:</strong> {selectedStudent.nationalId}</p>
                    <p><strong>الصف الدراسي:</strong> {selectedStudent.grade}</p>
                    <p><strong>الحالة العامة:</strong> {selectedStudent.status}</p>
                  </div>

                  <div className="space-y-2">
                    <p className="font-bold text-slate-900">مرئيات وتوصيات الموجه الطلابي:</p>
                    <p className="p-3 border rounded-lg bg-slate-50 text-slate-700 leading-relaxed">
                      تم عقد جلسة فردية مع الطالب ومتابعة تحصيله الدراسي مع المعلمين المعنيين،
                      ويُوصى بانتظام حضور الطالب في برامج التوجيه المعرفي مع إحاطة ولي الأمر دورياً.
                    </p>
                  </div>
                </div>

                {/* التوقيع */}
                <div className="flex justify-between items-end pt-8">
                  <div className="text-center space-y-1">
                    <p className="font-bold text-slate-900">الموجه الطلابي</p>
                    <p className="text-slate-500 text-[10px]">عبدالله المحمد</p>
                  </div>
                  <div className="text-center space-y-1">
                    <p className="font-bold text-slate-900">مدير المدرسة</p>
                    <p className="text-slate-500 text-[10px]">توقيع واعتماد رسمي</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}