import { supabase } from '@/integrations/supabase/client';

export interface KpiData {
  totalStudents: number;
  attendanceRate: number;
  activeCases: number;
  pendingReports: number;
}

export async function fetchDashboardKpis(): Promise<KpiData> {
  // 1. حساب إجمالي الطلاب
  const { count: totalStudents, error: errStudents } = await supabase
    .from('students')
    .select('*', { count: 'exact', head: true });

  if (errStudents) throw errStudents;

  // 2. حساب الحالات النشطة (قيد المتابعة)
  const { count: activeCases, error: errCases } = await supabase
    .from('cases')
    .select('*', { count: 'exact', head: true })
    .eq('status', 'active');

  if (errCases) throw errCases;

  // 3. حساب البلاغات المعلقة
  const { count: pendingReports, error: errReports } = await supabase
    .from('reports')
    .select('*', { count: 'exact', head: true })
    .eq('status', 'pending');

  if (errReports) throw errReports;

  // 4. استعلام متوسط معدل الحضور (مثال)
  // افترضنا وجود جدول للحضور والغياب فيه حقل 'is_present'
  const { data: attendanceData, error: errAttendance } = await supabase
    .from('attendance')
    .select('is_present');

  if (errAttendance) throw errAttendance;

  const totalRecords = attendanceData?.length || 0;
  const presentCount = attendanceData?.filter((a) => a.is_present).length || 0;
  const attendanceRate = totalRecords > 0 ? (presentCount / totalRecords) * 100 : 0;

  return {
    totalStudents: totalStudents || 0,
    attendanceRate: Number(attendanceRate.toFixed(1)),
    activeCases: activeCases || 0,
    pendingReports: pendingReports || 0,
  };
}